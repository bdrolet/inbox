# Copy to terraform.tfvars (gitignored) and fill in real values.
# MSAL cache: run scripts/seed_token_cache.py locally after device login, paste JSON string.

client_id        = "azure-app-client-id"
client_secret    = "azure-app-client-secret"
tenant_id        = "azure-tenant-id"
openai_api_key   = "sk-..."
msal_token_cache = "{\"Account\":{},\"AccessToken\":{},\"RefreshToken\":{},\"IdToken\":{},\"AppMetadata\":{}}"

# HuggingFace — from huggingface.co/settings/tokens (read scope)
hf_token = "hf_..."

# Search Cloud Function — generate with: openssl rand -hex 32
search_token     = "..."
# Comma-separated shared mailbox emails to search by default (leave empty if none)
shared_mailboxes = ""

# people-api (github.com/bdrolet/people) — Cloud Run URL for sender context at classify time
# real value: the people-api Cloud Run domain mapping
people_api_url = "https://people-api.example.com"

# GitHub Actions deployer service account (GCP_DEPLOYER_SA secret)
deployer_sa = "inbox-deployer@bens-project-462804.iam.gserviceaccount.com"
